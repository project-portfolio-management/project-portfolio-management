# Portfolio Service base URL (no trailing slash), read server-side by
# the BFF proxy (src/lib/server/config.ts, src/routes/api/proxy/[...path]).
# 5150 is the loco.rs default port the service binds in dev.
PROJECT_PORTFOLIO_MANAGEMENT_API_URL=http://localhost:5150

# Authentication service base URL (no trailing slash), read server-side
# for the magic-link sign-in flow and the session -> PASETO exchange
# (src/lib/server/auth.ts). Same default port as the portfolio service
# in a typical single-machine dev setup.
AUTH_API_URL=http://localhost:5150

# Opt-in "Sign in with SSO" link (OIDC via the auth service; see
# agents/share/authentication-sessions.md §7a and
# agents/share/runbooks/keycloak-sso.md). Set ONLY when the paired
# auth-service has its AUTH_OIDC_* variables configured; unset (the default)
# hides the link and makes /signin/sso a 404. Magic link stays the default.
# PUBLIC_OIDC_SIGNIN_ENABLED=true

# Direct OpenID Connect sign-in (HD-12, operations/sign-in-with-entra.md): this front-end's
# server side signs people in against an OpenID Connect provider itself, with the authorization
# code flow and PKCE, and sends the provider's access token to the API. Off unless
# PUBLIC_OIDC_DIRECT_ENABLED=true AND OIDC_ISSUER AND OIDC_CLIENT_ID are set.
#
# The API must verify that token, which it does for a Keycloak realm (build with the `keycloak`
# feature, set KEYCLOAK_*). So point OIDC_ISSUER at the Keycloak realm, and let Keycloak broker
# Microsoft Entra ID; do not point it at Entra directly unless your API accepts Entra tokens.
# PUBLIC_OIDC_DIRECT_ENABLED=true
# PUBLIC_OIDC_DIRECT_PROVIDER="Microsoft Entra ID"        # the name on the sign-in button
# OIDC_ISSUER=https://keycloak.example.com/realms/mxi     # Entra: https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=mxi-web                                   # a public client with PKCE needs no secret
# OIDC_CLIENT_SECRET=                                      # only for a confidential client
# OIDC_SCOPES="openid profile email offline_access"
# OIDC_TENANT_ID=                                          # Entra: refuse any other tenant's tokens
# OIDC_IDP_HINT=entra                                      # Keycloak: skip its chooser (kc_idp_hint)
# OIDC_REDIRECT_URI=https://app.example.com/signin/oidc/callback   # if the public address differs from the request's
# OIDC_SESSION_HOURS=8
# OIDC_IDLE_MINUTES=30                                     # sign out after this long without a request; 0 turns it off
# OIDC_END_SESSION=false                                   # true: also end the provider's session on sign-out

    "signIn.error.discovery": {
      "comment": "Error: discovery failed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in provider could not be reached, or did not answer as an OIDC provider."
          }
        }
      }
    },
    "signIn.error.heading": {
      "comment": "Heading of a sign-in error",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not signed in"
          }
        }
      }
    },
    "signIn.error.issuerMismatch": {
      "comment": "Error: discovery issuer differs",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider names its issuer %@, which is not the one set. Change the server settings to match it."
          }
        }
      }
    },
    "signIn.error.notAllowed": {
      "comment": "Error: provider is not HTTPS",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in provider and its endpoints must use https://."
          }
        }
      }
    },

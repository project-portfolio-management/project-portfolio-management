#!/bin/bash
# Test script for GitHub Discussions
#
# This script verifies:
# 1. Required discussion category files exist
# 2. GitHub Discussions links work correctly
#
# Usage: bin/test-github-discussions

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

ORG_SLUG="project-portfolio-management"
REPO_SLUG="project-portfolio-management"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Counters
PASS=0
FAIL=0

echo "==================================="
echo "GitHub Discussions Tests"
echo "==================================="
echo ""

# ============================================================================
# Test 1: Verify required files exist
# ============================================================================
echo "Test 1: Verifying discussion category files exist..."
echo ""

DECLARATIONS=(
  "locales/en-us/communications/github-discussions/announcements.txt:Announcements: Updates from maintainers"
  "locales/en-us/communications/github-discussions/general.txt:General: Chat about anything and everything here"
  "locales/en-us/communications/github-discussions/ideas.txt:Ideas: Share ideas for new features"
  "locales/en-us/communications/github-discussions/polls.txt:Polls: Take a vote from the community"
  "locales/en-us/communications/github-discussions/qa.txt:Q&A: Ask the community for help"
  "locales/en-us/communications/github-discussions/show-and-tell.txt:Show and tell: Show off something you've made"
)

for declaration in "${DECLARATIONS[@]}"; do
  IFS=':' read -r filepath expected_content <<< "$declaration"
  
  if [ -f "$REPO_ROOT/$filepath" ]; then
    content=$(cat "$REPO_ROOT/$filepath")
    if [ "$content" = "$expected_content" ]; then
      echo -e "${GREEN}✓${NC} $filepath exists with correct content"
      PASS=$((PASS + 1))
    else
      echo -e "${RED}✗${NC} $filepath exists but content mismatch"
      echo "  Expected: $expected_content"
      echo "  Got: $content"
      FAIL=$((FAIL + 1))
    fi
  else
    echo -e "${RED}✗${NC} $filepath does not exist"
    FAIL=$((FAIL + 1))
  fi
done

echo ""

# ============================================================================
# Test 2: Verify GitHub Discussions links
# ============================================================================
echo "Test 2: Verifying GitHub Discussions links..."
echo ""

pass() { echo -e "${GREEN}✓${NC} $1"; PASS=$((PASS + 1)); }
fail() { echo -e "${RED}✗${NC} $1"; FAIL=$((FAIL + 1)); }

if ! command -v curl &> /dev/null; then
  fail "curl is not installed, so the links cannot be checked"
else
  # The organization page must contain the text "View all discussions" (GitHub's own casing; matched
  # case-insensitively so a change of capitalization alone does not fail the test).
  ORG_URL="https://github.com/orgs/${ORG_SLUG}/discussions"
  echo "Checking: $ORG_URL"
  if curl -fsSL "$ORG_URL" 2>/dev/null | grep -qi "View all discussions"; then
    pass "$ORG_URL contains \"View all discussions\""
  else
    fail "$ORG_URL is unreachable or does not contain \"View all discussions\""
  fi
  echo ""

  # The repository's discussions URL must end at the organization's discussions (after any redirects).
  REPO_URL="https://github.com/${ORG_SLUG}/${REPO_SLUG}/discussions"
  expected="https://github.com/orgs/${ORG_SLUG}/discussions"
  echo "Checking: $REPO_URL (should redirect to $expected)"
  final=$(curl -sSL -o /dev/null -w '%{url_effective}' "$REPO_URL" 2>/dev/null || true)
  if [ "${final%/}" = "$expected" ]; then
    pass "$REPO_URL redirects to $expected"
  else
    fail "$REPO_URL ends at ${final:-nothing}, not $expected"
  fi
fi

echo ""

# ============================================================================
# Summary
# ============================================================================
echo "==================================="
echo "Test Summary"
echo "==================================="
echo "Passed: $PASS"
echo "Failed: $FAIL"
echo ""

if [ $FAIL -gt 0 ]; then
  echo -e "${RED}Some tests failed!${NC}"
  exit 1
else
  echo -e "${GREEN}All tests passed!${NC}"
  exit 0
fi

# Build output and local state that must never be tracked, anywhere in the tree.
target/
node_modules/
.svelte-kit/
test-results/
playwright-report/
build/
dist/
.vite/

# Local environment and secrets (examples stay tracked).
.env
.env.*
!.env.example
.DS_Store
*.log

# Local config overrides.
**/config/local.yaml
**/config/*.local.yaml
chaos-report.json

# Mistral Vibe local agent state.
.vibe/

# Reports from the load scripts.
distributed-load-test-results/
long-running-test-results/

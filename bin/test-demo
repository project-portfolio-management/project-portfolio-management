#!/usr/bin/env bash
# Smoke-test the demonstration stack (operations/demo.md).
#
# It starts the stack, checks the API from inside its container (the demonstration API publishes no host port),
# checks the UI on port 3000, and stops the stack. It is a smoke test of the running stack, not the Playwright suite:
# the UI's `tests/e2e/demo.spec.ts` stubs the API and starts its own server, so it does not test this stack.
#
# Usage:
#   bin/test-demo              # start, check, stop (keeps the data)
#   bin/test-demo start        # start only
#   bin/test-demo check        # check a running stack
#   bin/test-demo stop         # stop (keeps the data)
#
# The demonstration shares the `postgres` service and its volume with the normal local stack (operations/demo.md).
# This script never deletes a volume; to delete the demonstration data run
#   podman compose --profile demo down -v
# yourself, knowing it also deletes the local database.
#
# Requirements: Podman with Compose, curl.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

COMPOSE=(podman compose --profile demo)
UI_BASE_URL="http://127.0.0.1:3000"

GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

FAILED=0
pass() { echo -e "${GREEN}✓${NC} $1"; }
fail() { echo -e "${RED}✗${NC} $1"; FAILED=$((FAILED + 1)); }

# GET a path on the demonstration API from inside its container; prints the HTTP status.
api_status() {
  "${COMPOSE[@]}" exec -T api-demo curl --silent --output /dev/null --write-out '%{http_code}' "http://localhost:1241$1" || echo 000
}

start_demo() {
  command -v podman > /dev/null || { echo "Podman is required" >&2; return 1; }
  # `--wait` returns when every started service is healthy (api-demo and ui-demo have health checks) and the
  # one-shot seed job has completed. POSTGRES_PASSWORD must match the one the local volume was created with.
  POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-demo}" "${COMPOSE[@]}" up -d --build --wait ui-demo
}

stop_demo() {
  "${COMPOSE[@]}" down
}

check_demo() {
  echo "API (inside the api-demo container):"
  for path in /_health/live /_health/ready /_health/startup /api-docs/openapi.json; do
    status=$(api_status "$path")
    if [ "$status" = 200 ]; then pass "GET $path answers 200"; else fail "GET $path answers $status, not 200"; fi
  done
  # Login is on in the demonstration, so an unauthenticated list is refused.
  status=$(api_status /api/plans)
  if [ "$status" = 401 ]; then pass "GET /api/plans without a token answers 401"; else fail "GET /api/plans without a token answers $status, not 401"; fi

  echo "UI ($UI_BASE_URL):"
  for path in / /en-001/signin; do
    status=$(curl --silent --output /dev/null --write-out '%{http_code}' "$UI_BASE_URL$path" || echo 000)
    if [ "$status" -ge 200 ] && [ "$status" -lt 400 ]; then pass "GET $path answers $status"; else fail "GET $path answers $status"; fi
  done
  if curl --silent --head "$UI_BASE_URL/" | grep -qi '^content-type:.*text/html'; then
    pass "the UI answers HTML"
  else
    fail "the UI does not answer HTML"
  fi

  if [ "$FAILED" -gt 0 ]; then
    echo -e "${RED}$FAILED check(s) failed${NC}"
    return 1
  fi
  echo -e "${GREEN}All checks passed${NC}"
}

case "${1:-full}" in
  start) start_demo ;;
  stop) stop_demo ;;
  check) check_demo ;;
  full)
    trap stop_demo EXIT
    start_demo
    check_demo
    ;;
  *)
    echo "Usage: $0 [start|check|stop|full]" >&2
    exit 2
    ;;
esac

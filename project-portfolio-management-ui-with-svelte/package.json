{
  "name": "project-portfolio-management-ui-with-svelte",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "=26"
  },
  "description": "SvelteKit operator front-end for the project portfolio management service.",
  "license": "MIT OR Apache-2.0 OR BSD-3-Clause OR GPL-2.0-only OR GPL-3.0-only",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src",
    "lint": "prettier --check src tests playwright.config.ts vite.config.ts tsconfig.json eslint.config.js && eslint --max-warnings 0 src tests"
  },
  "dependencies": {
    "@fontsource/opendyslexic": "^5.3.0",
    "@lilydesignsystem/svelte-calendar": "0.7.0",
    "@lilydesignsystem/svelte-data-grid": "0.11.0",
    "@lilydesignsystem/svelte-gantt-chart": "0.8.0",
    "@lilydesignsystem/svelte-headless": "0.6.1",
    "@lilydesignsystem/svelte-kanban-board": "0.8.1",
    "@lilydesignsystem/svelte-locale-translations": "0.4.0",
    "@lilydesignsystem/svelte-picker-bar": "0.5.1",
    "@lilydesignsystem/svelte-share-picker": "0.3.0",
    "@lilydesignsystem/themes": "0.6.0",
    "@sveltia/i18n": "^1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
